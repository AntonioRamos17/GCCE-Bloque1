{"data": {"conn_name": "model.BI_project.stg_aguas_residuales", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "799d1a8759cf6d714aa1d99014d27ffc5cd9a477cc7ac181dc80e083b2c5417e", "node_finished_at": "", "node_name": "stg_aguas_residuales", "node_path": "staging/stg_aguas_residuales.sql", "node_relation": {"alias": "stg_aguas_residuales", "database": "ods_db", "relation_name": "\"ods_db\".\"public\".\"stg_aguas_residuales\"", "schema": "public"}, "node_started_at": "2026-01-03T23:27:34.547060", "node_status": "executing", "resource_type": "model", "unique_id": "model.BI_project.stg_aguas_residuales"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_aguas_residuales\"} */\n\n  create view \"ods_db\".\"public\".\"stg_aguas_residuales__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    trim(time_period_code)                      as anyo,\n    territorio_code                             as codigo_isla,\n    trim(medidas)                               as medida,\n    trim(medidas_code)                          as codigo_medida,\n    upper(trim(tipo_destino_uso))               as destino,    \n    upper(trim(tipo_destino_uso_code))          as codigo_destino,\n    cast(obs_value as numeric)                  as valor_medicion\n  from \"ods_db\".\"public\".\"aguas_residuales\"\n)\n\n\nselect\n  to_date(anyo || '-01-01','YYYY-MM-DD') as fecha_aproximada,\n  codigo_isla,\n  codigo_medida,\n  codigo_destino,\n  destino,\n  valor_medicion\nfrom base\nwhere upper(destino) LIKE '%AL MAR%'\n  );"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "769b288d-6d8f-4124-9f38-3d420bca8880", "level": "debug", "msg": "On model.BI_project.stg_aguas_residuales: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_aguas_residuales\"} */\n\n  create view \"ods_db\".\"public\".\"stg_aguas_residuales__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    trim(time_period_code)                      as anyo,\n    territorio_code                             as codigo_isla,\n    trim(medidas)                               as medida,\n    trim(medidas_code)                          as codigo_medida,\n    upper(trim(tipo_destino_uso))               as destino,    \n    upper(trim(tipo_destino_uso_code))          as codigo_destino,\n    cast(obs_value as numeric)                  as valor_medicion\n  from \"ods_db\".\"public\".\"aguas_residuales\"\n)\n\n\nselect\n  to_date(anyo || '-01-01','YYYY-MM-DD') as fecha_aproximada,\n  codigo_isla,\n  codigo_medida,\n  codigo_destino,\n  destino,\n  valor_medicion\nfrom base\nwhere upper(destino) LIKE '%AL MAR%'\n  );", "name": "SQLQuery", "pid": 87180, "thread": "Thread-1 (worker)", "ts": "2026-01-03T23:27:34.614451Z"}}
