{"data": {"conn_name": "model.BI_project.f_visitantes_parque_anyo", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "83d21f4e6b72bafbfdab7140934758e50247e46dc2c7731da1b5eb1610ca51d6", "node_finished_at": "", "node_name": "f_visitantes_parque_anyo", "node_path": "facts/f_visitantes_parque_anyo.sql", "node_relation": {"alias": "f_visitantes_parque_anyo", "database": "ods_db", "relation_name": "\"ods_db\".\"public\".\"f_visitantes_parque_anyo\"", "schema": "public"}, "node_started_at": "2026-01-03T23:27:38.444811", "node_status": "executing", "resource_type": "model", "unique_id": "model.BI_project.f_visitantes_parque_anyo"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.f_visitantes_parque_anyo\"} */\n\n  create view \"ods_db\".\"public\".\"f_visitantes_parque_anyo__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    extract(year from fecha_aproximada)::int as anyo,\n    v.codigo_parque,\n    v.valor_medicion::numeric as n_visitantes\n  from \"ods_db\".\"public\".\"stg_visitantes_espacios_naturales\" v\n)\n\nselect\n  anyo,\n  p.codigo_parque,\n  sum(n_visitantes) as n_visitantes\nfrom base b\nleft join \"ods_db\".\"public\".\"dim_parque\" p\n  on b.codigo_parque = p.codigo_parque\ngroup by anyo, p.codigo_parque\n  );"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "769b288d-6d8f-4124-9f38-3d420bca8880", "level": "debug", "msg": "On model.BI_project.f_visitantes_parque_anyo: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.f_visitantes_parque_anyo\"} */\n\n  create view \"ods_db\".\"public\".\"f_visitantes_parque_anyo__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    extract(year from fecha_aproximada)::int as anyo,\n    v.codigo_parque,\n    v.valor_medicion::numeric as n_visitantes\n  from \"ods_db\".\"public\".\"stg_visitantes_espacios_naturales\" v\n)\n\nselect\n  anyo,\n  p.codigo_parque,\n  sum(n_visitantes) as n_visitantes\nfrom base b\nleft join \"ods_db\".\"public\".\"dim_parque\" p\n  on b.codigo_parque = p.codigo_parque\ngroup by anyo, p.codigo_parque\n  );", "name": "SQLQuery", "pid": 87180, "thread": "Thread-1 (worker)", "ts": "2026-01-03T23:27:38.507683Z"}}
