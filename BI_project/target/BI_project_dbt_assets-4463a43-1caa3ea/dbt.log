{"data": {"conn_name": "model.BI_project.stg_visitantes_espacios_naturales", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "ab3ad684ad1a0c9b9298b4100b7a4955431a48555f617c77fb2e4705631202ab", "node_finished_at": "", "node_name": "stg_visitantes_espacios_naturales", "node_path": "staging/stg_visitantes_espacios_naturales.sql", "node_relation": {"alias": "stg_visitantes_espacios_naturales", "database": "ods_db", "relation_name": "\"ods_db\".\"public\".\"stg_visitantes_espacios_naturales\"", "schema": "public"}, "node_started_at": "2026-01-03T19:14:09.457608", "node_status": "executing", "resource_type": "model", "unique_id": "model.BI_project.stg_visitantes_espacios_naturales"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_visitantes_espacios_naturales\"} */\n\n  create view \"ods_db\".\"public\".\"stg_visitantes_espacios_naturales__dbt_tmp\"\n    \n    \n  as (\n    with base as ( \n    select\n        upper(trim(espacio_natural_protegido_code)) as codigo_parque,\n        trim(time_period_code)                      as raw_anyo,\n        trim(medidas)                               as medida,\n        trim(medidas_code)                          as codigo_medida,\n        cast(obs_value as numeric)                  as valor_medicion\n    from \"ods_db\".\"public\".\"visitantes_espacios_naturales\"\n),\n\nfechas as (\n    select\n        case\n            when raw_anyo ~ '^\\d{4}$'\n                then to_date(raw_anyo || '-01-01','YYYY-MM-DD')\n            when raw_anyo ~ '^\\d{4}-M\\d{2}$'\n                then to_date(regexp_replace(raw_anyo, '-M', '-') || '-01','YYYY-MM-DD')\n            else null\n        end as fecha_aproximada,\n        codigo_parque,\n        codigo_medida,\n        medida,\n        valor_medicion\n    from base\n),\n\nparques as (\n    select distinct\n        codigo_parque,\n        codigo_isla,\n        nombre_parque\n    from \"ods_db\".\"public\".\"dim_parque_seed\"\n)\n\nselect\n    f.fecha_aproximada,\n    f.codigo_parque,\n    p.codigo_isla,\n    p.nombre_parque,\n    f.codigo_medida,\n    f.medida,\n    f.valor_medicion\nfrom fechas f\nleft join parques p\n    on f.codigo_parque = p.codigo_parque\n  );"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "81ad3a1e-1312-4430-ae01-af314a939c66", "level": "debug", "msg": "On model.BI_project.stg_visitantes_espacios_naturales: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_visitantes_espacios_naturales\"} */\n\n  create view \"ods_db\".\"public\".\"stg_visitantes_espacios_naturales__dbt_tmp\"\n    \n    \n  as (\n    with base as ( \n    select\n        upper(trim(espacio_natural_protegido_code)) as codigo_parque,\n        trim(time_period_code)                      as raw_anyo,\n        trim(medidas)                               as medida,\n        trim(medidas_code)                          as codigo_medida,\n        cast(obs_value as numeric)                  as valor_medicion\n    from \"ods_db\".\"public\".\"visitantes_espacios_naturales\"\n),\n\nfechas as (\n    select\n        case\n            when raw_anyo ~ '^\\d{4}$'\n                then to_date(raw_anyo || '-01-01','YYYY-MM-DD')\n            when raw_anyo ~ '^\\d{4}-M\\d{2}$'\n                then to_date(regexp_replace(raw_anyo, '-M', '-') || '-01','YYYY-MM-DD')\n            else null\n        end as fecha_aproximada,\n        codigo_parque,\n        codigo_medida,\n        medida,\n        valor_medicion\n    from base\n),\n\nparques as (\n    select distinct\n        codigo_parque,\n        codigo_isla,\n        nombre_parque\n    from \"ods_db\".\"public\".\"dim_parque_seed\"\n)\n\nselect\n    f.fecha_aproximada,\n    f.codigo_parque,\n    p.codigo_isla,\n    p.nombre_parque,\n    f.codigo_medida,\n    f.medida,\n    f.valor_medicion\nfrom fechas f\nleft join parques p\n    on f.codigo_parque = p.codigo_parque\n  );", "name": "SQLQuery", "pid": 444157, "thread": "Thread-1 (worker)", "ts": "2026-01-03T19:14:09.509007Z"}}
