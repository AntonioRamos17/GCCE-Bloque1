),

joined as (
  select
    t.anyo,
    t.codigo_isla,
    t.nombre_isla,
    t.n_turistas,
    i.n_infracciones_ambientales
  from turistas_anyo t
  full join infracciones_ambientales_anyo i
    on t.anyo = i.anyo and t.codigo_isla = i.codigo_isla
)

select
