{"data": {"conn_name": "model.BI_project.f_turistas_isla_mes", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "2d3485158eedbcd3214be1ec4efe9768861ade7b13594c74f6c3127808784265", "node_finished_at": "", "node_name": "f_turistas_isla_mes", "node_path": "facts/f_turistas_isla_mes.sql", "node_relation": {"alias": "f_turistas_isla_mes", "database": "ods_db", "relation_name": "\"ods_db\".\"public\".\"f_turistas_isla_mes\"", "schema": "public"}, "node_started_at": "2026-01-03T19:14:09.655592", "node_status": "executing", "resource_type": "model", "unique_id": "model.BI_project.f_turistas_isla_mes"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.f_turistas_isla_mes\"} */\n\n  create view \"ods_db\".\"public\".\"f_turistas_isla_mes__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    tr.fecha_aproximada,\n    tr.codigo_isla,\n    i.nombre_isla,\n    tr.valor_medicion::numeric as n_turistas\n  from \"ods_db\".\"public\".\"stg_turistas_recibidos\" tr\n  join \"ods_db\".\"public\".\"dim_isla\" i\n    on i.codigo_isla = tr.codigo_isla\n  where tr.codigo_medida LIKE '%ABSOLUTE%'\n  order by tr.codigo_isla, tr.fecha_aproximada\n  -- group by tr.fecha_aproximada, tr.codigo_isla, tr.codigo_medida, i.nombre_isla\n  -- having tr.codigo_medida LIKE '%ABSOLUTE%'\n)\nselect\n  fecha_aproximada,\n  codigo_isla,\n  nombre_isla,\n  n_turistas\nfrom base\n  );"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "81ad3a1e-1312-4430-ae01-af314a939c66", "level": "debug", "msg": "On model.BI_project.f_turistas_isla_mes: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.f_turistas_isla_mes\"} */\n\n  create view \"ods_db\".\"public\".\"f_turistas_isla_mes__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    tr.fecha_aproximada,\n    tr.codigo_isla,\n    i.nombre_isla,\n    tr.valor_medicion::numeric as n_turistas\n  from \"ods_db\".\"public\".\"stg_turistas_recibidos\" tr\n  join \"ods_db\".\"public\".\"dim_isla\" i\n    on i.codigo_isla = tr.codigo_isla\n  where tr.codigo_medida LIKE '%ABSOLUTE%'\n  order by tr.codigo_isla, tr.fecha_aproximada\n  -- group by tr.fecha_aproximada, tr.codigo_isla, tr.codigo_medida, i.nombre_isla\n  -- having tr.codigo_medida LIKE '%ABSOLUTE%'\n)\nselect\n  fecha_aproximada,\n  codigo_isla,\n  nombre_isla,\n  n_turistas\nfrom base\n  );", "name": "SQLQuery", "pid": 444157, "thread": "Thread-1 (worker)", "ts": "2026-01-03T19:14:09.699329Z"}}
