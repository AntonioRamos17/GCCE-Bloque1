    codigo_isla,
    avg(valor_medicion) as carencia_bienes_vivienda
  from "ods_db"."public"."stg_carencia_bienes_vivienda"
  group by anyo, codigo_isla
)

select
  t.anyo,
  t.codigo_isla,
  t.nombre_isla,
  t.n_turistas,
  v.precio_m2_medio,
  c.carencia_bienes_vivienda,
