{"data": {"conn_name": "model.BI_project.stg_valor_vivienda_m2", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "460c13c0e46226b3a7268922cfbd02e2f7745fe488f784ca870b0ece1d2706ce", "node_finished_at": "", "node_name": "stg_valor_vivienda_m2", "node_path": "staging/stg_valor_vivienda_m2.sql", "node_relation": {"alias": "stg_valor_vivienda_m2", "database": "ods_db", "relation_name": "\"ods_db\".\"public\".\"stg_valor_vivienda_m2\"", "schema": "public"}, "node_started_at": "2026-01-03T23:27:35.412401", "node_status": "executing", "resource_type": "model", "unique_id": "model.BI_project.stg_valor_vivienda_m2"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_valor_vivienda_m2\"} */\n\n  create view \"ods_db\".\"public\".\"stg_valor_vivienda_m2__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    upper(trim(geographical_code))          as codigo_isla,\n    trim(time_code)                         as time_code_raw,\n    trim(measure)                           as medida,\n    trim(measure_code)                      as codigo_medida,\n    cast(obs_value as numeric)              as valor_medicion\n  from \"ods_db\".\"public\".\"valor_vivienda_m2\"\n  where measure_code like 'ABSOLUTE'\n)\n\nselect\n  make_date(\n    split_part(time_code_raw, '-', 1)::int,\n    case split_part(time_code_raw, '-', 2) \n      when 'Q1' then 1   -- enero\n      when 'Q2' then 4   -- abril\n      when 'Q3' then 7   -- julio\n      when 'Q4' then 10  -- octubre\n    end,\n    1\n  )::date as fecha_aproximada,\n  codigo_isla,\n  codigo_medida,\n  medida,\n  valor_medicion\nfrom base\nwhere time_code_raw !~* '^\\d{4}$'\n  );"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "769b288d-6d8f-4124-9f38-3d420bca8880", "level": "debug", "msg": "On model.BI_project.stg_valor_vivienda_m2: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_valor_vivienda_m2\"} */\n\n  create view \"ods_db\".\"public\".\"stg_valor_vivienda_m2__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    upper(trim(geographical_code))          as codigo_isla,\n    trim(time_code)                         as time_code_raw,\n    trim(measure)                           as medida,\n    trim(measure_code)                      as codigo_medida,\n    cast(obs_value as numeric)              as valor_medicion\n  from \"ods_db\".\"public\".\"valor_vivienda_m2\"\n  where measure_code like 'ABSOLUTE'\n)\n\nselect\n  make_date(\n    split_part(time_code_raw, '-', 1)::int,\n    case split_part(time_code_raw, '-', 2) \n      when 'Q1' then 1   -- enero\n      when 'Q2' then 4   -- abril\n      when 'Q3' then 7   -- julio\n      when 'Q4' then 10  -- octubre\n    end,\n    1\n  )::date as fecha_aproximada,\n  codigo_isla,\n  codigo_medida,\n  medida,\n  valor_medicion\nfrom base\nwhere time_code_raw !~* '^\\d{4}$'\n  );", "name": "SQLQuery", "pid": 87180, "thread": "Thread-1 (worker)", "ts": "2026-01-03T23:27:35.464826Z"}}
