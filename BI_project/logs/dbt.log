  create view "ods_db"."public"."f_infracciones_ambientales_mes__dbt_tmp"
    
    
  as (
    with base as (
  select
    ia.fecha_aproximada,
    ia.codigo_isla,
    i.nombre_isla,
    ia.valor_medicion::numeric as n_infracciones_ambientales
  from "ods_db"."public"."stg_infracciones_ambientales" ia
