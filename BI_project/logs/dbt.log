  group by anyo
),

visitantes_parques_anyo as (
  select
    extract(year from fecha_aproximada)::int as anyo,
    sum(valor_medicion)::numeric as n_visitantes_parques
  from "ods_db"."public"."stg_visitantes_espacios_naturales"
  group by anyo
),

