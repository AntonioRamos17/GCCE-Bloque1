      0
    ) as n_turistas_minmax,

  -- Min-max global infracciones ambientales
  (n_infracciones_ambientales
    - min(n_infracciones_ambientales) over ()
  )
  / nullif(
      max(n_infracciones_ambientales) over ()
      - min(n_infracciones_ambientales) over (),
      0
    ) as n_infracciones_ambientales_minmax

from joined
