{"data": {"conn_name": "model.BI_project.stg_turistas_recibidos", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "b512efb5fb3676f9382721358aa8ba12beb397ac17ace35552abbbe021e7f742", "node_finished_at": "", "node_name": "stg_turistas_recibidos", "node_path": "staging/stg_turistas_recibidos.sql", "node_relation": {"alias": "stg_turistas_recibidos", "database": "ods_db", "relation_name": "\"ods_db\".\"public\".\"stg_turistas_recibidos\"", "schema": "public"}, "node_started_at": "2026-01-03T19:14:08.175174", "node_status": "executing", "resource_type": "model", "unique_id": "model.BI_project.stg_turistas_recibidos"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_turistas_recibidos\"} */\n\n  create view \"ods_db\".\"public\".\"stg_turistas_recibidos__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    upper(trim(geographical_code))          as codigo_isla,\n    trim(time_code)                         as time_code_raw,\n    trim(measure)                           as medida,\n    trim(measure_code)                      as codigo_medida,\n    cast(obs_value as numeric)              as valor_medicion\n  from \"ods_db\".\"public\".\"turistas_recibidos\"\n)\n\nselect\n  to_date(time_code_raw || '-01', 'YYYY-MM-DD') as fecha_aproximada,\n  codigo_isla,\n  codigo_medida,\n  medida,\n  valor_medicion\nfrom base\nwhere time_code_raw !~* '^\\d{4}$'\n  );"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "81ad3a1e-1312-4430-ae01-af314a939c66", "level": "debug", "msg": "On model.BI_project.stg_turistas_recibidos: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_turistas_recibidos\"} */\n\n  create view \"ods_db\".\"public\".\"stg_turistas_recibidos__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    upper(trim(geographical_code))          as codigo_isla,\n    trim(time_code)                         as time_code_raw,\n    trim(measure)                           as medida,\n    trim(measure_code)                      as codigo_medida,\n    cast(obs_value as numeric)              as valor_medicion\n  from \"ods_db\".\"public\".\"turistas_recibidos\"\n)\n\nselect\n  to_date(time_code_raw || '-01', 'YYYY-MM-DD') as fecha_aproximada,\n  codigo_isla,\n  codigo_medida,\n  medida,\n  valor_medicion\nfrom base\nwhere time_code_raw !~* '^\\d{4}$'\n  );", "name": "SQLQuery", "pid": 444157, "thread": "Thread-1 (worker)", "ts": "2026-01-03T19:14:08.221447Z"}}
