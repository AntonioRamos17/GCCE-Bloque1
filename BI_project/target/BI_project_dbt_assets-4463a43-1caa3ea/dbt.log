{"data": {"conn_name": "model.BI_project.stg_afiliaciones_turismo", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "69bd838c8da070492c36a0bfa98e42c74544d2df43e09f96d830c382747f2be5", "node_finished_at": "", "node_name": "stg_afiliaciones_turismo", "node_path": "staging/stg_afiliaciones_turismo.sql", "node_relation": {"alias": "stg_afiliaciones_turismo", "database": "ods_db", "relation_name": "\"ods_db\".\"public\".\"stg_afiliaciones_turismo\"", "schema": "public"}, "node_started_at": "2026-01-03T19:14:07.397595", "node_status": "executing", "resource_type": "model", "unique_id": "model.BI_project.stg_afiliaciones_turismo"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_afiliaciones_turismo\"} */\n\n  create view \"ods_db\".\"public\".\"stg_afiliaciones_turismo__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    upper(trim(geographical_code))          as codigo_isla,\n    trim(time_code)                         as time_code_raw,\n    trim(measure)                           as medida,\n    trim(measure_code)                      as codigo_medida,\n    cast(obs_value as numeric)              as valor_medicion\n  from \"ods_db\".\"public\".\"afiliaciones_turismo\"\n  where measure_code like 'ABSOLUTE'\n)\n\nselect\n  to_date(time_code_raw || '-01-01', 'YYYY-MM-DD') as fecha_aproximada,\n  codigo_isla,\n  codigo_medida,\n  medida,\n  valor_medicion\nfrom base\n  );"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "81ad3a1e-1312-4430-ae01-af314a939c66", "level": "debug", "msg": "On model.BI_project.stg_afiliaciones_turismo: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_afiliaciones_turismo\"} */\n\n  create view \"ods_db\".\"public\".\"stg_afiliaciones_turismo__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    upper(trim(geographical_code))          as codigo_isla,\n    trim(time_code)                         as time_code_raw,\n    trim(measure)                           as medida,\n    trim(measure_code)                      as codigo_medida,\n    cast(obs_value as numeric)              as valor_medicion\n  from \"ods_db\".\"public\".\"afiliaciones_turismo\"\n  where measure_code like 'ABSOLUTE'\n)\n\nselect\n  to_date(time_code_raw || '-01-01', 'YYYY-MM-DD') as fecha_aproximada,\n  codigo_isla,\n  codigo_medida,\n  medida,\n  valor_medicion\nfrom base\n  );", "name": "SQLQuery", "pid": 444157, "thread": "Thread-1 (worker)", "ts": "2026-01-03T19:14:07.446025Z"}}
