select
  make_date(
    split_part(time_code_raw, '-', 1)::int,
    case split_part(time_code_raw, '-', 2) 
      when 'Q1' then 1   -- enero
      when 'Q2' then 4   -- abril
      when 'Q3' then 7   -- julio
      when 'Q4' then 10  -- octubre
    end,
    1
  )::date as fecha_aproximada,
  codigo_isla,
  codigo_medida,
  medida,
