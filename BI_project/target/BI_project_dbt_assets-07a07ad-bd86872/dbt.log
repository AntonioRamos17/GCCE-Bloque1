{"data": {"conn_name": "model.BI_project.stg_ipc_mes", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "817fe520a1ae4be65dc2e7314018eeca727947d110c436f64bc7f7ba9b8ac408", "node_finished_at": "", "node_name": "stg_ipc_mes", "node_path": "staging/stg_ipc_mes.sql", "node_relation": {"alias": "stg_ipc_mes", "database": "ods_db", "relation_name": "\"ods_db\".\"public\".\"stg_ipc_mes\"", "schema": "public"}, "node_started_at": "2026-01-03T23:27:35.056027", "node_status": "executing", "resource_type": "model", "unique_id": "model.BI_project.stg_ipc_mes"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_ipc_mes\"} */\n\n  create view \"ods_db\".\"public\".\"stg_ipc_mes__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    upper(trim(geographical_code))          as codigo_isla,\n    trim(time_code)                         as time_code_raw,\n    trim(measure)                           as medida,\n    trim(measure_code)                      as codigo_medida,\n    cast(obs_value as numeric)              as valor_medicion\n  from \"ods_db\".\"public\".\"ipc_mes\"\n  where measure_code like 'ABSOLUTE'\n)\n\nselect\n  to_date(time_code_raw || '-01-01', 'YYYY-MM-DD') as fecha_aproximada,\n  codigo_isla,\n  codigo_medida,\n  medida,\n  valor_medicion\nfrom base\n  );"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "769b288d-6d8f-4124-9f38-3d420bca8880", "level": "debug", "msg": "On model.BI_project.stg_ipc_mes: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"node_id\": \"model.BI_project.stg_ipc_mes\"} */\n\n  create view \"ods_db\".\"public\".\"stg_ipc_mes__dbt_tmp\"\n    \n    \n  as (\n    with base as (\n  select\n    upper(trim(geographical_code))          as codigo_isla,\n    trim(time_code)                         as time_code_raw,\n    trim(measure)                           as medida,\n    trim(measure_code)                      as codigo_medida,\n    cast(obs_value as numeric)              as valor_medicion\n  from \"ods_db\".\"public\".\"ipc_mes\"\n  where measure_code like 'ABSOLUTE'\n)\n\nselect\n  to_date(time_code_raw || '-01-01', 'YYYY-MM-DD') as fecha_aproximada,\n  codigo_isla,\n  codigo_medida,\n  medida,\n  valor_medicion\nfrom base\n  );", "name": "SQLQuery", "pid": 87180, "thread": "Thread-1 (worker)", "ts": "2026-01-03T23:27:35.118521Z"}}
