{"data": {"conn_name": "list_ods_db_public", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"connection_name\": \"list_ods_db_public\"} */\nselect\n      'ods_db' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'public'\n    union all\n    select\n      'ods_db' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'public'\n    union all\n    select\n      'ods_db' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'public'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "81ad3a1e-1312-4430-ae01-af314a939c66", "level": "debug", "msg": "On list_ods_db_public: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.13\", \"profile_name\": \"BI_project\", \"target_name\": \"dev\", \"connection_name\": \"list_ods_db_public\"} */\nselect\n      'ods_db' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'public'\n    union all\n    select\n      'ods_db' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'public'\n    union all\n    select\n      'ods_db' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'public'\n  ", "name": "SQLQuery", "pid": 444157, "thread": "ThreadPoolExecutor-1_0", "ts": "2026-01-03T19:14:07.049264Z"}}
